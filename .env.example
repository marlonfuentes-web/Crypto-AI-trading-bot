# MEXC API Credentials
MEXC_API_KEY=your_api_key_here
MEXC_SECRET_KEY=your_secret_here

# Trading Mode: paper or live
TRADING_MODE=paper

# Symbols to trade (comma-separated)
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT,ADA/USDT,AVAX/USDT,LINK/USDT,MATIC/USDT

# Market type
USE_FUTURES=true
LEVERAGE=3

# Risk Management
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_CONCURRENT_TRADES=3
MIN_CONVICTION_SCORE=5
MIN_RR_RATIO=2.0
AI_CONFIDENCE_THRESHOLD=0.60

# Capital (USDT)
CAPITAL_USDT=1000.0

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
